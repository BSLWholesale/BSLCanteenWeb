
@{
    ViewBag.Title = "AllEmployeeMonthlyReport";
}

@{
    <script src="~/Web/js/jquery-3.7.1.min.js"></script>
    <link href="~/Web/css/select2.min.css" rel="stylesheet" />
    <script src="~/Web/js/jquery-ui.min.js"></script>
    <link href="~/Web/css/jquery-ui.css" rel="stylesheet" />

    <script type="text/javascript">

        $(document).ready(function () {

            var strFieldName = " CONCAT(EmpName, ' (', EmployeeId, ')') AS EmpName ";

            Fn_Fill_DropdownList("ddlEmpName", "EmployeeMaster", strFieldName, "EmployeeId", "");
            Fn_Fill_DropdownList("ddlCanteen", "CanteenMaster", "CanteenName", "CanteenId", "");

            //Fn_DailyMonthlyReport_EmpDetail();

        });


        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {

            var clsRequestDropdown = {};

            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;

            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);

            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }
                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }


        function formatDate(date) {

            var day = String(date.getDate()).padStart(2, '0');
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = months[date.getMonth()];
            var year = date.getFullYear();

            return day + "-" + month + "-" + year;

        }

        var currentPage = 1;
        var pageSize = 500;
        var isLoading = false;
        var hasMoreData = true;
        var rCount = 0;


        function Fn_DailyMonthlyReport_EmpDetail(isScroll = false) {

            var clsDailyMonthlyAllEmpDetailReq = {};

            if (isLoading || !hasMoreData)
                return;

            //var html = "";
            //$("#tbodyEmpMonthlyDetail").html("");
            
            clsDailyMonthlyAllEmpDetailReq.CurrentDate = null;
            clsDailyMonthlyAllEmpDetailReq.CanteenId = $("#ddlCanteen").val();

            var empId = $("#ddlEmpName").val();
            if (empId === "0" || empId === 0 || empId === null || empId === "") {
                clsDailyMonthlyAllEmpDetailReq.EmpId = null;
            }
            else {
                clsDailyMonthlyAllEmpDetailReq.EmpId = parseInt(empId);
            }

            clsDailyMonthlyAllEmpDetailReq.PeriodType = $("#ddlDays").val();
            clsDailyMonthlyAllEmpDetailReq.PageNumber = currentPage;
            clsDailyMonthlyAllEmpDetailReq.PageSize = pageSize;

            // Clear only first time
            if (!isScroll) {
                $("#tbodyEmpMonthlyDetail").html('');
                currentPage = 1;
                hasMoreData = true;
            }

            isLoading = true;

            $.ajax({
                type: "POST",
                url: "/Staff/Fn_DailyMonthlyReport_EmpDetail",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsDailyMonthlyAllEmpDetailReq),
                beforeSend: function () {
                    $("#loader").show();
                },
                success: function (data) {

                    var obj = JSON.parse(data.message);
                    var gTotalRows = 0;
                    var html = "";
                    if (obj.length > 0 && obj[0].vErrorMsg == "Success") {
                        
                        gTotalRows = obj[0].TotalRows;
                        
                        for (var i = 0; i < obj.length; i++) {
                            html += "<tr>";
                            html += "<td>" + obj[i].EmpId + "</td>";
                            html += "<td>" + obj[i].EmpName + "</td>";
                            html += "<td>" + obj[i].CanteenName + "</td>";
                            html += "<td>" + obj[i].CouponId + "</td>";

                            if (obj[i].ItemCatgeory == "Tea") {
                                html += "<td class='clsmenu'>☕ Tea</td>";
                            }
                            else if (obj[i].ItemCatgeory == "Thali") {
                                html += "<td class='clsmenu'>🍛 Thali</td>";
                            }
                            else if (obj[i].ItemCatgeory == "Mini Thali") {
                                html += "<td class='clsmenu'>🍛 Mini Thali</td>";
                            }
                            else if (obj[i].ItemCatgeory == "Breakfast") {
                                html += "<td class='clsmenu'>🍽️ Breakfast</td>";
                            }
                            else {
                                html += "<td></td>";
                            }

                            html += "<td>" + obj[i].OrderTakenDate + "</td>";
                            html += "</tr>";
                            rCount++;
                        }
                        // Append data instead of replace
                        $("#tbodyEmpMonthlyDetail").append(html);
                        $("#spTotalRowCount").html("Total Rows: " + rCount + " / " + gTotalRows);
                        // Next page
                        currentPage++;

                        // If less than page size => no more data
                        if (obj.length < 30) {
                            hasMoreData = false;
                        }
                    }
                    else {
                        hasMoreData = false;
                    }
                },
                complete: function () {
                    $("#loader").hide();
                    isLoading = false;
                },
                error: function (err) {
                    Swal.fire({ title: "", text: err, icon: "error" });
                }
            });
        }


        function onRadioChange() {

            var selectedValue = $('input[name="rb"]:checked').val();

            if (selectedValue == "Employeewise") {
                Fn_DailyMonthlyReport_EmpDetail();
            }
            //else if (selectedValue == "EmployeewiseSummery") {
            //    Fn_DailyMonthlyReport_EmpDetail();
            //}
            else {
            }

        }



        $(window).scroll(function () {

            if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                var selectedValue = $('input[name="rb"]:checked').val();

                if (selectedValue == "Employeewise") {
                    Fn_DailyMonthlyReport_EmpDetail(true);
                }
                //else if (selectedValue == "EmployeewiseSummery") {
                //    Fn_DailyMonthlyReport_EmpDetail(true);
                //}
                else {

                }
            }

        });

    </script>
}



<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">
            <h4>All Employee Today/Monthly Report</h4>
            <span class="pull-right" id="spTotalRowCount" style="color: black; font-weight: 800;"></span>
            <div class="card">
                <div class="row mt-2">
                    <div class="col-sm-4">
                        <label>Canteen</label>
                        <select id="ddlCanteen" class="form-control" onchange="onRadioChange();">
                            <option value="0">--Select--</option>
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <label>Employee</label>
                        <select id="ddlEmpName" class="form-control" onchange="onRadioChange();">
                            <option value="0">--Select--</option>
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <label>Days</label>
                        <select id="ddlDays" class="form-control" onchange="onRadioChange();">
                            <option value="Monthly">Monthly</option>
                            <option value="Today">Today</option>
                        </select>
                    </div>
                    <div class="col-sm-8">

                        <div class="row mt-1">
                            <!-- Detail Column -->
                            <div class="col-md-6">
                                @*<h5 style="background-color:#007bff; color:white; padding:10px; border-radius:5px;">
                                        Detail
                                    </h5>*@

                                <label>
                                    <input type="radio" name="rb" value="Employeewise"
                                           onclick="onRadioChange();" checked="checked" />
                                    Employeewise Detail
                                </label>
                            </div>

                            <!-- Summary Column -->
                            <div class="col-md-6">
                                @*<h5 style="background-color:#28a745; color:white; padding:10px; border-radius:5px;">
                                        Summary
                                    </h5>*@

                                <label>
                                    <input type="radio" name="rb" value="EmployeewiseSummery"
                                           onchange="onRadioChange();" />
                                    Employeewise Summary
                                </label>
                            </div>
                        </div>

                    </div>
                    <div class="col-sm-4 position-relative">
                        <div class="position-absolute bottom-0 end-0" style="padding-right: 15px;">
                            <button id="btnSearch" class="btn btn-primary mt-4" onclick="onRadioChange();"> Search</button>
                            @*<button id="btnExport" class="btn btn-primary mt-4" onclick="Fn_ExportExcel();"> Export</button>*@
                        </div>
                    </div>
                </div>
                <div class="table-responsive mt-3">
                    <!-- Employee Detail Table start-->
                    <table class="table table-bordered table-hover" id="tblEmp">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Emp Id</th>
                                <th>Emp Name</th>
                                <th>Canteen Name</th>
                                <th>Coupon ID</th>
                                <th>Item Category</th>
                                <th>Order Taken Date</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyEmpMonthlyDetail"></tbody>
                    </table>

                    <!-- Employee Summery Start-->
                    <table class="table table-bordered table-hover" id="tblEmpSummery" style="display: none;">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Emp Id</th>
                                <th>Emp Name</th>
                                <th>Canteen Name</th>
                                <th>TotalCoupons</th>
                                <th>Amt</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyEmpSummery"></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>

    <div id="loader" style="margin-top: 15%; text-align: center; display: none;">
        <img src="~/Web/img/loading.gif?timestamp(~/Web/img/loading.gif)" width="8%" />
    </div>

</div>
<!-- Team End -->

<script src="~/Web/js/select2.min.js"></script>
<script>
    $(function () {
        $("#ddlEmpName").select2();
        $("#ddlCanteen").select2();
        $("#ddlDays").select2();
    });
</script>