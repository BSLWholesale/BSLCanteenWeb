    // New JS Code Solution
    function Fn_MonthlyReport_UPIDataCanteenWise() {

        try {

            var clsUPIMonthlyReportRequest = {};

            clsUPIMonthlyReportRequest.FromDate = $("#txtFromDate").val();
            clsUPIMonthlyReportRequest.ToDate = $("#txtToDate").val();

            if (!clsUPIMonthlyReportRequest.FromDate ||
                !clsUPIMonthlyReportRequest.ToDate) {
                alert("Please select From Date and To Date.");
                return;
            }

            $.ajax({
                type: "POST",
                url: "/Staff/Fn_MonthlyReport_UPIDataCanteenWise",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsUPIMonthlyReportRequest),

                success: function (data) {

                    try {

                        console.log("API Response:", data);

                        if (!data || data.message === undefined || data.message === null) {

                            $("#dvUPIMonthlyData").html(
                                "<tr>" +
                                "<td colspan='100%' class='text-center text-danger'>" +
                                "No data returned from server." +
                                "</td>" +
                                "</tr>"
                            );
                            return;
                        }

                        var obj = data.message;

                        // Parse main response
                        if (typeof obj === "string") {

                            if ($.trim(obj) === "") {

                                $("#dvUPIMonthlyData").html(
                                    "<tr>" +
                                    "<td colspan='100%' class='text-center'>" +
                                    "No data found." +
                                    "</td>" +
                                    "</tr>"
                                );

                                return;
                            }

                            try {
                                obj = JSON.parse(obj);
                            }
                            catch (jsonError) {

                                console.error("JSON Parse Error:", jsonError);

                                $("#dvUPIMonthlyData").html(
                                    "<tr>" +
                                    "<td colspan='100%' class='text-center text-danger'>" +
                                    "Invalid data returned from server." +
                                    "</td>" +
                                    "</tr>"
                                );

                                return;
                            }
                        }

                        if (!Array.isArray(obj)) {

                            console.error(
                                "Expected array but received:",
                                obj
                            );

                            $("#dvUPIMonthlyData").html(
                                "<tr>" +
                                "<td colspan='100%' class='text-center text-danger'>" +
                                "Invalid report data format." +
                                "</td>" +
                                "</tr>"
                            );

                            return;
                        }

                        if (obj.length === 0) {

                            $("#dvUPIMonthlyData").html(
                                "<tr>" +
                                "<td colspan='100%' class='text-center'>" +
                                "No data found." +
                                "</td>" +
                                "</tr>"
                            );

                            return;
                        }

                        // Date validation
                        var fromDate = parseReportDate(
                            clsUPIMonthlyReportRequest.FromDate
                        );

                        var toDate = parseReportDate(
                            clsUPIMonthlyReportRequest.ToDate
                        );

                        if (!fromDate || !toDate) {
                            alert("Invalid From Date or To Date.");
                            return;
                        }

                        fromDate.setHours(0, 0, 0, 0);
                        toDate.setHours(0, 0, 0, 0);

                        if (fromDate > toDate) {
                            alert("From Date cannot be greater than To Date.");
                            return;
                        }

                        // Create date columns
                        var dateColumns = [];

                        var currentDate = new Date(
                            fromDate.getFullYear(),
                            fromDate.getMonth(),
                            fromDate.getDate()
                        );

                        while (currentDate <= toDate) {

                            dateColumns.push({
                                date: new Date(currentDate),
                                display: formatReportDate(currentDate)
                            });

                            currentDate.setDate(currentDate.getDate() + 1);
                        }

                        // Create table
                        var html = "";

                        html += "<thead>";
                        html += "<tr>";

                        html +=
                            "<th style='text-align:center; white-space:nowrap;'>Location ID</th>";

                        html +=
                            "<th style='text-align:center; white-space:nowrap;'>Rate</th>";

                        for (var d = 0; d < dateColumns.length; d++) {

                            html +=
                                "<th style='text-align:center; white-space:nowrap;'>" +
                                escapeHtml(dateColumns[d].display) +
                                "</th>";
                        }

                        html +=
                            "<th style='text-align:center; white-space:nowrap;'>Total Qty</th>";

                        html +=
                            "<th style='text-align:center; white-space:nowrap;'>Total Amount</th>";

                        html += "</tr>";
                        html += "</thead>";

                        html += "<tbody>";

                        // LOCATION ID TRACKING
                        var previousLocationID = null;

                        for (var i = 0; i < obj.length; i++) {

                            var row = obj[i];

                            // GET LOCATION ID
                            var locationID = row.LocationID;

                            if (locationID === null || locationID === undefined || locationID === "") {
                                locationID = "";
                            }

                            // Convert to string for safe comparison
                            locationID = String(locationID);

                            // SHOW LOCATION ID ONLY WHEN IT CHANGES
                            var displayLocationID = "";

                            if (i === 0 ||
                                locationID !== previousLocationID) {

                                displayLocationID = locationID;
                            }

                            // Save current Location ID
                            previousLocationID = locationID;

                            // GET RATE
                            var rate = row.Rate;

                            if (rate === null || rate === undefined || rate === "") {
                                rate = 0;
                            }

                            rate = parseFloat(rate);

                            if (isNaN(rate)) {
                                rate = 0;
                            }

                            // GET DATE WISE QUANTITY
                            var dateWiseQty = row.DateWiseQty;

                            console.log("Location ID:", locationID,
                                "Display:", displayLocationID,
                                "DateWiseQty:", dateWiseQty
                            );

                            // Parse DateWiseQty if string
                            if (typeof dateWiseQty === "string") {

                                if ($.trim(dateWiseQty) !== "") {

                                    try {
                                        dateWiseQty = JSON.parse(dateWiseQty);
                                    }
                                    catch (dateJsonError) {

                                        console.error("Invalid DateWiseQty JSON:", dateJsonError);

                                        dateWiseQty = {};
                                    }
                                }
                                else {
                                    dateWiseQty = {};
                                }
                            }

                            if (!dateWiseQty) {
                                dateWiseQty = {};
                            }

                            // CREATE ROW
                            html += "<tr>";

                            // Location ID
                            html +=
                                "<td style='text-align:center;'>" +
                                escapeHtml(displayLocationID) +
                                "</td>";

                            // Rate
                            html +=
                                "<td style='text-align:center;'>" +
                                rate.toFixed(2) +
                                "</td>";

                            // DATE WISE QUANTITY
                            var totalQty = 0;

                            for (var d = 0; d < dateColumns.length; d++) {

                                var requestedDate = dateColumns[d].display;

                                var qty =
                                    getDateWiseQuantity(dateWiseQty, requestedDate);

                                if (qty === null || qty === undefined || qty === "") {
                                    qty = 0;
                                }

                                qty = parseFloat(qty);

                                if (isNaN(qty)) {
                                    qty = 0;
                                }

                                totalQty += qty;

                                html +=
                                    "<td style='text-align:center;'>" +
                                    qty +
                                    "</td>";
                            }

                            // TOTAL AMOUNT
                            var totalAmount = totalQty * rate;

                            html +=
                                "<td style='text-align:center; font-weight:bold;'>" +
                                totalQty +
                                "</td>";

                            html +=
                                "<td style='text-align:center; font-weight:bold;'>" +
                                totalAmount.toFixed(2) +
                                "</td>";

                            html += "</tr>";
                        }

                        html += "</tbody>";

                        // Display table
                        $("#tblUPIMonthlyData").html(html);

                    }
                    catch (e) {

                        console.error("UPI Monthly Report Processing Error:", e);

                        $("#dvUPIMonthlyData").html(
                            "<tr>" +
                            "<td colspan='100%' class='text-center text-danger'>" +
                            "Error: " +
                            escapeHtml(
                                e.message || "Unknown error"
                            ) +
                            "</td>" +
                            "</tr>"
                        );
                    }
                },

                error: function (xhr, status, error) {

                    console.error("AJAX Error:", error);
                    console.error("Status:", status);
                    console.error("Response:", xhr.responseText);

                    var errorMessage =
                        "Unable to load UPI Monthly Data.";

                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }

                    $("#dvUPIMonthlyData").html(
                        "<tr>" +
                        "<td colspan='100%' class='text-center text-danger'>" +
                        escapeHtml(errorMessage) +
                        "</td>" +
                        "</tr>"
                    );
                }
            });

        }
        catch (e) {
            console.error("Outer Error:", e);
            alert("Error while processing UPI Monthly Data.\n\n" + e.message);
        }
    }
    // New JS Code Solution



    // PARSE DATE

    function parseReportDate(value) {

        if (!value) {
            return null;
        }
        
        if (value instanceof Date) {
            if (isNaN(value.getTime())) {
                return null;
            }

            return new Date(value);
        }

        value = $.trim(value.toString());
        
        var match = value.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);

        if (match) {

            var year = parseInt(match[1], 10);
            var month = parseInt(match[2], 10) - 1;
            var day = parseInt(match[3], 10);

            var date = new Date(year, month, day);

            if (date.getFullYear() === year && date.getMonth() === month && date.getDate() === day)
            {
                return date;
            }
        }
        
        match = value.match(/^(\d{1,2})-(\d{1,2})-(\d{4})$/);

        if (match) {

            var day2 = parseInt(match[1], 10);
            var month2 = parseInt(match[2], 10) - 1;
            var year2 = parseInt(match[3], 10);

            var date2 = new Date(year2, month2, day2);

            if (
                date2.getFullYear() === year2 &&
                date2.getMonth() === month2 &&
                date2.getDate() === day2
            ) {
                return date2;
            }
        }
       
        match = value.match(
            /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/
        );

        if (match) {

            var month3 = parseInt(match[1], 10) - 1;
            var day3 = parseInt(match[2], 10);
            var year3 = parseInt(match[3], 10);

            var date3 = new Date(year3, month3, day3);

            if (
                date3.getFullYear() === year3 &&
                date3.getMonth() === month3 &&
                date3.getDate() === day3
            ) {
                return date3;
            }
        }
       
        var parsed = new Date(value);

        if (!isNaN(parsed.getTime())) {
            return parsed;
        }

        return null;
    }
   
    function formatReportDate(date) {

        if (!(date instanceof Date) ||
            isNaN(date.getTime())) {

            return "";
        }

        var day = ("0" + date.getDate()).slice(-2);

        var months = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
        ];

        var month = months[date.getMonth()];
        var year = date.getFullYear();
        return day + "-" + month + "-" + year;
    }

    function getDateWiseQuantity(dateWiseQty, requestedDate) {

        if (!dateWiseQty) {
            return 0;
        }
       
        if (Array.isArray(dateWiseQty)) {

            for (var i = 0; i < dateWiseQty.length; i++) {

                var item = dateWiseQty[i];

                if (!item) {
                    continue;
                }

                var itemDate = item.Date || item.DateValue || item.ReportDate;
                var itemQty = item.Qty || item.Quantity || item.TotalQty || 0;

                if (itemDate) {

                    var formattedItemDate = formatReportDate(parseReportDate(itemDate));
                    if (normalizeReportDate(formattedItemDate) === normalizeReportDate(requestedDate))
                    {
                        return itemQty;
                    }
                }
            }

            return 0;
        }
        
        if (typeof dateWiseQty === "object") {

            // Direct key
            if (Object.prototype.hasOwnProperty.call(dateWiseQty, requestedDate))
            {
                return dateWiseQty[requestedDate];
            }

            // Normalized key comparison
            var requestedNormalized = normalizeReportDate(requestedDate);

            for (var key in dateWiseQty) {
                if (Object.prototype.hasOwnProperty.call(dateWiseQty, key)) {

                    var keyNormalized = normalizeReportDate(key);

                    if (keyNormalized === requestedNormalized) {
                        return dateWiseQty[key];
                    }
                }
            }
        }

        return 0;
    }
  
    function normalizeReportDate(value) {

        if (!value) {
            return "";
        }

        var date = parseReportDate(value);

        if (!date) {
            return $.trim(value).toLowerCase();
        }

        return (
            date.getFullYear() +
            "-" +
            ("0" + (date.getMonth() + 1)).slice(-2) +
            "-" +
            ("0" + date.getDate()).slice(-2)
        );
    }


    function escapeHtml(value) {

        if (value === null || value === undefined ) {
            return "";
        }

        return $("<div>").text(value).html();
    }


</script>

