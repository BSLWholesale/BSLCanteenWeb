<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">
            @*<h4>Daily Canteen and Item Category Wise Report</h4>*@
            <p><b>Today's <span id="spnTodayDate"></span> Count</b></p>

            <div class="card">

                <div class="row">
                    <div class="col-sm-3 mt-3">
                        <input type="text" id="txtCurrentDate" name="txtCurrentDate" class="form-control" />
                    </div>

                    @*<div class="col-sm-3 mt-3">
                        <input type="text" id="txtToDate" name="txtToDate" class="form-control" />
                    </div>*@

                    <div class="col-sm-3 mt-3">
                        <button id="btnSubmit" name="btnSubmit" class="btn btn-primary" onclick="Fn_DailyReport_Shiftwise(); Fn_DailyReport_ItemCategorywise(); Fn_DailyReport_ItemWise(); Fn_DailyReport_Canteenwise();">Submit</button>
                    </div>
                </div>

                <div class="col-sm-12 mt-4 position-relative">
                    <h5>Daily Shift Wise Report</h5>
                    <div class="position-absolute bottom-0 end-0" style="padding-right: 15px;">
                        <button id="btnExportShift" class="btn btn-primary mt-4" onclick="Fn_ExportExcelShiftWise();">Export Shift Wise</button>
                    </div>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover" id="tblShiftWiseReport" onchange="Fn_DailyReport_Shiftwise();">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Canteen Name</th>
                                <th>Shift Name</th>
                                <th style="text-align:center;">No of Workers</th>
                                @*<th style="text-align:center;">Tea</th>*@
                                <th style="text-align:center;">Scanned QR Tea</th>
                                @*<th style="text-align:center;">Breakfast</th>*@
                                <th style="text-align:center;">Scanned QR Breakfast</th>
                                @*<th style="text-align:center;">Thali</th>*@
                                <th style="text-align:center;">Scanned QR Thali</th>
                                @*<th style="text-align:center;">Mini Thali</th>*@
                                <th style="text-align:center;">Scanned QR Mini Thali</th>
                            </tr>
                        </thead>
                        <tbody id="tbody_Shift">
                        </tbody>
                    </table>
                </div>


                <div class="col-sm-12 mt-3 position-relative">
                    <h5>Daily Item Category Wise Report</h5>
                    <div class="position-absolute bottom-0 end-0" style="padding-right: 15px;">
                        <button id="btnExportCategory" class="btn btn-primary mt-4" onclick="Fn_ExportExcelCategoryWise();">Export Category Wise</button>
                    </div>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover" id="tblCategoryWiseReport" onchange="Fn_DailyReport_Canteenwise();">
