
@{
    ViewBag.Title = "StaffTodayHistory";
}


@{
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <link href="~/Web/css/select2.min.css" rel="stylesheet" />

    <script type="text/javascript">

        $(document).ready(function () {

            var CurrentDate = new Date();

            var day = String(CurrentDate.getDate()).padStart(2, '0');
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = months[CurrentDate.getMonth()];
            var year = CurrentDate.getFullYear();

            var formattedDate = day + "-" + month + "-" + year;
            $("#spnDate").html(formattedDate);
            var spnCanteen = sessionStorage.getItem("CanteenName");
            $("#spCanteen").html(spnCanteen);

            Fn_Get_Coupon_Order();
            Fn_Get_Count_ItemMenu()

        });


        function Fn_Get_Coupon_Order() {

            var CurrentDate = new Date();

            var day = String(CurrentDate.getDate()).padStart(2, '0');
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = months[CurrentDate.getMonth()];
            var year = CurrentDate.getFullYear();

            var formattedDate = day + "-" + month + "-" + year;

            $("#spnDate").html(formattedDate);

            var clsCouponReport = {};
            clsCouponReport.ModifiedBy = sessionStorage.getItem("LogInID");
            clsCouponReport.OrderStatus = "Scanned";
            clsCouponReport.OrderTakenDate = formattedDate;
            clsCouponReport.CanteenId = sessionStorage.getItem("CanteenId");
            $("#tbody").html('');
            var html = '';

            $.ajax({
                type: "POST",
                url: "/Staff/Fn_Get_Coupon_Order",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsCouponReport),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        for (var i = 0; i < obj.length; i++) {

                            var orderTime = obj[i].OrderTakenTime; // Example: 02:35:PM
                            var shift = "";

                            if (orderTime) {
                                var timeParts = orderTime.split(":");
                                var hour = parseInt(timeParts[0], 10);
                                var minute = parseInt(timeParts[1], 10);
                                var ampm = timeParts[2].toUpperCase();

                                // Convert to 24-hour format
                                if (ampm === "AM" && hour === 12) {
                                    hour = 0;
                                }
                                else if (ampm === "PM" && hour !== 12) {
                                    hour += 12;
                                }

                                if (hour >= 7 && hour < 15) {
                                    shift = "Shift A";
                                }
                                else if (hour >= 15 && hour < 23) {
                                    shift = "Shift B";
                                }
                                else {
                                    shift = "Shift C";
                                }
                            }

                            html += "<tr>";
                            html += "<td>" + obj[i].OrderTakenTime + "</td>";
                            html += "<td>" + obj[i].CouponId + "</td>";
                            html += "<td>" + obj[i].EmpId + "</td>";
                            html += "<td>" + obj[i].EmpName + (obj[i].CouponType != 'Self' ? " <b>(" + obj[i].CouponType + ")</b>" : "") + "</td>";
                            html += "<td>" + obj[i].EmpDepartment + "</td>";
                            html += "<td>" + obj[i].CategoryIcon + " " + obj[i].ItemCategory + " <b>(₹" + obj[i].Price + ")</b></td>";
                            html += "<td>" + obj[i].Category + "</td>";
                            html += "<td>" + shift + "</td>";
                            html += "</tr>";
                        }
                    }
                    else {
                        html += "<tr>";
                        html += "<td colspan='8' class='text-center'>" + obj[0].vErrorMsg + "</td>";
                        html += "</tr>";
                    }
                    $("#tbody").append(html);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }


        function Fn_Get_Count_ItemMenu() {

            var today = new Date();

            var day = String(today.getDate()).padStart(2, '0');
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = months[today.getMonth()];
            var year = today.getFullYear();

            var formattedDate = day + "-" + month + "-" + year;

            var clsCountMenuItem = {};
            clsCountMenuItem.OrderTakenDate = formattedDate;
            clsCountMenuItem.CanteenId = sessionStorage.getItem("CanteenId");
            $("#ItemCountRow").html('');
            var html = '';
            $.ajax({
                type: "POST",
                url: '/Admin/Fn_Get_Count_ItemMenu',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsCountMenuItem),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {

                        var cardStyles = [
                            { bg: "#E3F2FD", border: "#2196F3", shadow: "rgba(33,150,243,0.25)" },
                            { bg: "#E8F5E9", border: "#4CAF50", shadow: "rgba(76,175,80,0.25)" },
                            { bg: "#FFF3E0", border: "#FF9800", shadow: "rgba(255,152,0,0.25)" },
                            { bg: "#F3E5F5", border: "#9C27B0", shadow: "rgba(156,39,176,0.25)" },
                            { bg: "#FCE4EC", border: "#E91E63", shadow: "rgba(233,30,99,0.25)" },
                            { bg: "#E0F7FA", border: "#00BCD4", shadow: "rgba(0,188,212,0.25)" }
                        ];

                        html += "<div class='row food-card-container'>";

                        for (var i = 0; i < obj.length; i++) {

                            var style = cardStyles[i % cardStyles.length];

                            html += "<div class='col-3 mb-3'>";
                            html += "<div class='p-3' style='background:" + style.bg + ";" + "border:1px solid " + style.border + ";" + "border-radius:15px; box-shadow:0 5px 15px " + style.shadow + ";" + "height:100%;'>";
                            html += "<div style='font-size:12px;font-weight:800;color:" + style.border + ";'>";
                            html += obj[i].CategoryIcon + " " + obj[i].ItemCategory + " - " + obj[i].CountItem;
                            html += "</div>";
                            html += "</div>";
                            html += "</div>";
                        }

                        html += "</div>";
                        $("#ItemCountRow").append(html);
                    }
                    else {

                    }

                },
                error: function (err) {
                    alert(err);
                }
            });
        }
       

    </script>
    
}


<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">

            <h4><span id="spCanteen"></span> — Today's Records</h4>
            <p>Today's <span id="spnDate"></span> Transactions</p>
            <div class="row" id="ItemCountRow">

            </div>
            <div class="card">
                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Time</th>
                                <th>Coupon ID</th>
                                <th>Emp ID</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Item</th>
                                <th>Item Category</th>
                                <th>Shift</th>
                            </tr>
                        </thead>
                        <tbody id="tbody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

