
@{
    ViewBag.Title = "ViewEmployeeList";
}

<script type="text/javascript">


    $(document).ready(function () {
        Fn_Fetch_All_Employee();
    });


    function Fn_Fetch_All_Employee() {

        var clsEmployee = {};

        var html = "";
        $("#tbody").html("");

        clsEmployee.EmpLocation = sessionStorage.getItem("EmpLocation");
        if ($("#txtSearch").val() != "") {
            clsEmployee.EmpId = $("#txtSearch").val().trim();
        }

        $.ajax({
            type: "POST",
            url: "/Admin/Fn_Fetch_All_Employee",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsEmployee),
            success: function (data) {
                var obj = JSON.parse(data.message);
                if (obj[0].vErrorMsg == "Success") {
                    for (var i = 0; i < obj.length; i++) {
                        html += "<tr>";
                        html += "<td>" + obj[i].EmpId + "</td>";
                        html += "<td>" + obj[i].EmpName + "</td>";
                        html += "<td>" + obj[i].Department + "</td>";
                        html += "<td>" + obj[i].EmpMobile + "</td>";
                        html += "<td>" + obj[i].EmpLocation + "</td>";
                        html += "<td>" + obj[i].EmpRole + "</td>";
                        html += "<td>" + obj[i].CanteenName + "</td>";   
                        html += "<td><a href='javascript: void(0);' class='btn btn-xs sharp btn-info edit'><i class='fa' style='align-content:center;' onclick=\"Fn_NavigateToEditEmployee(" + obj[i].EmpId + ",'" + obj[i].EmpLocation + "')\">Edit</i></td>";

                        html += "</tr>";
                    }
                }
                else {
                    html += "<tr><td colspan='12' class='text-center'>No Employee/Worker records found.</td></tr>";
                }
                $("#tbody").append(html);
            },
            error: function (err) {
                alert(err);
            }
        });
    }


    function Fn_NavigateToEditEmployee(EmpId, EmpLocation) {
        
        window.location.href = "/Admin/EditEmployeeDetails?EID=" + EmpId + "&ELocation=" + EmpLocation;

    }


    function Fn_NavigateToAddDivision() {

        var AddEmployee = $("#btnAddEmployee").val();
        AddEmployee = window.location.replace("@Url.Action("AddEmployee", "Admin")");
        return true;
    }

    ////////////// 12-Nov-2026 adde by Ankit

    function Fn_ExportExcel() {

        var tab = "";
        var dt = new Date();
        dt = dt.toLocaleDateString();
        var strFileName = "EmployeeList_" + dt;
        tab = document.getElementById('tblEmpList');

        var tab_text = "<table border='2px'>";

        for (var j = 0; j < tab.rows.length; j++) {

            tab_text += "<tr>";

            var cells = tab.rows[j].cells;

            for (var i = 0; i < cells.length - 1; i++) {

                var cellValue = "";
                var tagName = cells[i].tagName.toLowerCase();

                // Check if td has class="clsmenu"
                if (cells[i].classList.contains("clsmenu")) {

                    // Export only plain text
                    cellValue = cells[i].textContent
                        .replace(/☕/g, "")
                        .replace(/🍛/g, "")
                        .replace(/🍽️/g, "")
                        .replace(/\s+/g, " ")
                        .trim();

                } else {

                    // Normal text
                    cellValue = cells[i].innerText.trim();
                }

                if (tagName === "th") {

                    tab_text += "<th bgcolor='#87AFC6'>" + cellValue + "</th>";

                }
                else if (i === 0) {

                    tab_text += "<td style=\"mso-number-format:'0';\">" + cellValue + "</td>";

                }
                else {

                    tab_text += "<td>" + cellValue + "</td>";
                }
            }

            tab_text += "</tr>";
        }

        tab_text += "</table>";

        // Remove unwanted HTML elements
        tab_text = tab_text.replace(/<A[^>]*>|<\/A>/gi, "");
        tab_text = tab_text.replace(/<img[^>]*>/gi, "");
        tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

        var ua = window.navigator.userAgent;
        var msie = ua.indexOf("MSIE ");

        var sa = "";

        if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {

            txtArea1.document.open("txt/html", "replace");
            txtArea1.document.write(tab_text);
            txtArea1.document.close();
            txtArea1.focus();

            sa = txtArea1.document.execCommand(
                "SaveAs",
                true,
                strFileName + ".xls"
            );

        } else {

            var blob = new Blob(
                [tab_text],
                {
                    type: "application/vnd.ms-excel"
                }
            );

            var link = document.createElement("a");

            link.href = URL.createObjectURL(blob);
            link.download = strFileName + ".xls";

            document.body.appendChild(link);
            link.click();

            document.body.removeChild(link);
        }

        return sa;
    }

</script>

<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="card-body">
                    <div class="row card-header">
                        <div class="col-sm-6">
                            <h5>View Employee/Worker List</h5>
                        </div>
                        <div class="col-sm-3">
                            <input type="text" id="txtSearch" class="form-control" placeholder="Search Emp ID..." onkeydown="if (event.key === 'Enter') Fn_Fetch_All_Employee();" />
                        </div>
                        <div class="col-sm-3">
                            <button class="btn btn-primary" title="Add Employee/Worker" id="btnAddEmployee" name="btnAddEmployee" value="Add Employee/Worker" onclick="Fn_NavigateToAddDivision();">Add Employee</button>
                            <button class="btn btn-primary" onclick="Fn_ExportExcel();">Export</button>
                        </div>
                    </div>

                    <div class="table-responsive mt-3">
                        <table class="table table-bordered table-hover" id="tblEmpList">
                            <thead>
                                <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                    <th>Emp ID</th>
                                    <th>Name</th>
                                    <th>Department</th>
                                    <th>Mobile</th>
                                    <th>Location</th>
                                    <th>Role</th>
                                    <th>Canteen Name</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="tbody">
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>