
@{
    ViewBag.Title = "DailyCategorywiseReport";
}

<script src="~/Web/js/jquery-3.7.1.min.js"></script>
<link href="~/Web/css/select2.min.css" rel="stylesheet" />
<script src="~/Web/js/jquery-ui.min.js"></script>
<link href="~/Web/css/jquery-ui.css" rel="stylesheet" />

<script type="text/javascript">

    $(document).ready(function () {

        Fn_DailyReport_Canteenwise();
        Fn_DailyReport_ItemCategorywise();

        const CurrentDate = new Date();
        const yyyy = CurrentDate.getFullYear();
        const monthnames = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
            "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

        let dd = CurrentDate.getDate();
        if (dd < 10) dd = '0' + dd;

        const mmm = monthnames[CurrentDate.getMonth()];

        const dateformat = dd + '-' + mmm + '-' + yyyy;

        $("#spnTodayDate").html(dateformat);

    });


    function Fn_DailyReport_Canteenwise() {
        var clsCategoryReport = {};

        var html = "";
        $("#tbody_Canteen").html("");

        $.ajax({
            type: "POST",
            url: "/Admin/Fn_DailyReport_Canteenwise",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsCategoryReport),
            success: function (data) {
                var obj = JSON.parse(data.message);
                // Initialize totals
                var totalWorkers = 0;
                var totalGenerated = 0;
                var totalScanned = 0;

                if (obj[0].vErrorMsg == "Success") {
                    for (var i = 0; i < obj.length; i++) {

                        totalWorkers += parseInt(obj[i].Noofworkers) || 0;
                        totalGenerated += parseInt(obj[i].GeneratedCoupons) || 0;
                        totalScanned += parseInt(obj[i].ScannedCoupons) || 0;

                        html += "<tr>";
                        html += "<td>" + obj[i].CanteenName + "</td>";
                        html += "<td style='text-align:center;'>" + obj[i].Noofworkers + "</td>";
                        html += "<td style='text-align:center;'>" + obj[i].GeneratedCoupons + "</td>";
                        html += "<td style='text-align:center;'>" + obj[i].ScannedCoupons + "</td>";
                        html += "</tr>";
                    }

                    // Add Total Row
                    html += "<tr style='font-weight:bold;background:#f2f2f2;'>";
                    html += "<td>Total</td>";
                    html += "<td style='text-align:center;'>" + totalWorkers + "</td>";
                    html += "<td style='text-align:center;'>" + totalGenerated + "</td>";
                    html += "<td style='text-align:center;'>" + totalScanned + "</td>";
                    html += "</tr>";
                }
                else {
                    html += "<tr><td colspan='12' class='text-center'>Canteen wise records are not found.</td></tr>";
                }
                $("#tbody_Canteen").append(html);
            },
            error: function (err) {
                alert(err);
            }
        });
    }


    function Fn_DailyReport_ItemCategorywise() {

        var clsCategoryReport = {};

        var html = "";
        $("#tbody_Category").html("");

        $.ajax({
            type: "POST",
            url: "/Admin/Fn_DailyReport_ItemCategorywise",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsCategoryReport),
            success: function (data) {
                var obj = JSON.parse(data.message);
                // Initialize totals
                var totalWorkers = 0;
                var totalGenTeaCoupons = 0;
                var totalScanTeaCoupons = 0;
                var totalGenBreakfastCoupons = 0;
                var totalScanBreakfastCoupons = 0;
                var totalGenThaliCoupons = 0;
                var totalScanThaliCoupons = 0;
                var totalGenMiniThaliCoupons = 0;
                var totalScanMiniThaliCoupons = 0;

                if (obj[0].vErrorMsg == "Success") {
                    for (var i = 0; i < obj.length; i++) {

                        totalWorkers += parseInt(obj[i].Noofworkers) || 0;
                        totalGenTeaCoupons += parseInt(obj[i].GeneratedCouponTea) || 0;
                        totalScanTeaCoupons += parseInt(obj[i].QRScannedTea) || 0;
                        totalGenBreakfastCoupons += parseInt(obj[i].GeneratedCouponBreakfast) || 0;
                        totalScanBreakfastCoupons += parseInt(obj[i].QRScannedBreakfast) || 0;
                        totalGenThaliCoupons += parseInt(obj[i].GeneratedCouponThali) || 0;
                        totalScanThaliCoupons += parseInt(obj[i].QRScannedThali) || 0;
                        totalGenMiniThaliCoupons += parseInt(obj[i].GeneratedCouponMiniThali) || 0;
                        totalScanMiniThaliCoupons += parseInt(obj[i].QRScannedMiniThali) || 0;

                        html += "<tr>";
                        html += "<td>" + obj[i].CanteenName + "</td>";
                        html += "<td style='text-align:center;'>" + obj[i].Noofworkers + "</td>";
                        html += "<td style='text-align:center; background-color:#E1BEE7;'>" + obj[i].GeneratedCouponTea + "</td>";
                        html += "<td style='text-align:center; background-color:#E1BEE7;'>" + obj[i].QRScannedTea + "</td>";
                        html += "<td style='text-align:center; background-color:#FFCCBC;'>" + obj[i].GeneratedCouponBreakfast + "</td>";
                        html += "<td style='text-align:center; background-color:#FFCCBC;'>" + obj[i].QRScannedBreakfast + "</td>";
                        html += "<td style='text-align:center; background-color:#ADD8E6;'>" + obj[i].GeneratedCouponThali + "</td>";
                        html += "<td style='text-align:center; background-color:#ADD8E6;'>" + obj[i].QRScannedThali + "</td>";
                        html += "<td style='text-align:center; background-color:#C8E6C9;'>" + obj[i].GeneratedCouponMiniThali + "</td>";
                        html += "<td style='text-align:center; background-color:#C8E6C9;'>" + obj[i].QRScannedMiniThali + "</td>";
                        html += "</tr>";
                    }

                    // Add Total Row
                    html += "<tr style='font-weight:bold;background:#f2f2f2;'>";
                    html += "<td>Total</td>";
                    html += "<td style='text-align:center;'>" + totalWorkers + "</td>";
                    html += "<td style='text-align:center;'>" + totalGenTeaCoupons + "</td>";
                    html += "<td style='text-align:center;'>" + totalScanTeaCoupons + "</td>";
                    html += "<td style='text-align:center;'>" + totalGenBreakfastCoupons + "</td>";
                    html += "<td style='text-align:center;'>" + totalScanBreakfastCoupons + "</td>";
                    html += "<td style='text-align:center;'>" + totalGenThaliCoupons + "</td>";
                    html += "<td style='text-align:center;'>" + totalScanThaliCoupons + "</td>";
                    html += "<td style='text-align:center;'>" + totalGenMiniThaliCoupons + "</td>";
                    html += "<td style='text-align:center;'>" + totalScanMiniThaliCoupons + "</td>";
                }
                else {
                    html += "<tr><td colspan='12' class='text-center'>Item category wise records are not found.</td></tr>";
                }
                $("#tbody_Category").append(html);
            },
            error: function (err) {
                alert(err);
            }
        });
    }


    function Fn_ExportExcelCanteenWise() {

        var strFileName = "DailyCanteenWiseReport";
        var tableData = document.getElementById('tblCanteenWiseReport');

        var tab_text = "<table border='2px'><tr bgcolor='#87AFC6'>";
        var textRange; var j = 0;

        for (j = 0; j < tableData.rows.length; j++) {
            tab_text = tab_text + tableData.rows[j].innerHTML + "</tr>";
        }

        tab_text = tab_text + "</table>";
        tab_text = tab_text.replace(/<A[^>]*>|<\/A>/g, "");
        tab_text = tab_text.replace(/<img[^>]*>/gi, "");
        tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

        let a = document.createElement('a');
        a.href = `data:application/vnd.ms-excel, ${encodeURIComponent(tab_text)}`
        a.download = strFileName + '.xls'
        a.click()
    }



    function Fn_ExportExcelCategoryWise() {

        var strFileName = "DailyCategoryWiseReport";
        var tableData = document.getElementById('tblCategoryWiseReport');

        var tab_text = "<table border='2px'><tr bgcolor='#87AFC6'>";
        var textRange; var i = 0;

        for (i = 0; i < tableData.rows.length; i++) {
            tab_text = tab_text + tableData.rows[i].innerHTML + "</tr>";
        }

        tab_text = tab_text + "</table>";
        tab_text = tab_text.replace(/<A[^>]*>|<\/A>/g, "");
        tab_text = tab_text.replace(/<img[^>]*>/gi, "");
        tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

        let a = document.createElement('a');
        a.href = `data:application/vnd.ms-excel, ${encodeURIComponent(tab_text)}`
        a.download = strFileName + '.xls'
        a.click()

    }

</script>


<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">
            <h4>Daily Canteen and Item Category Wise Report</h4>
            <p><b>Today's <span id="spnTodayDate"></span> Generated and Scanned Count</b></p>

            <div class="card">

                <div class="col-sm-12 mt-5 position-relative">
                    <div class="position-absolute bottom-0 end-0" style="padding-right: 15px;">
                        <button id="btnExportCanteen" class="btn btn-primary mt-4" onclick="Fn_ExportExcelCanteenWise();">Export Canteen Wise</button>
                    </div>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover" id="tblCanteenWiseReport">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Canteen Name</th>
                                <th style="text-align:center;">No of Workers</th>
                                <th style="text-align:center;">Generated Count</th>
                                <th style="text-align:center;">Scanned Count</th>
                            </tr>
                        </thead>
                        <tbody id="tbody_Canteen">
                        </tbody>
                    </table>
                </div>

                <div class="col-sm-12 mt-5 position-relative">
                    <div class="position-absolute bottom-0 end-0" style="padding-right: 15px;">
                        <button id="btnExportCategory" class="btn btn-primary mt-4" onclick="Fn_ExportExcelCategoryWise();">Export Category Wise</button>
                    </div>
                </div>

                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover" id="tblCategoryWiseReport">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Canteen Name</th>
                                <th style="text-align:center;">Workers</th>
                                <th style="text-align:center;">Tea</th>
                                <th style="text-align:center;">QR Tea</th>
                                <th style="text-align:center;">Breakfast</th>
                                <th style="text-align:center;">QR Breakfast</th>
                                <th style="text-align:center;">Thali</th>
                                <th style="text-align:center;">QRThali</th>
                                <th style="text-align:center;">Mini Thali</th>
                                <th style="text-align:center;">QR Mini Thali</th>
                            </tr>
                        </thead>
                        <tbody id="tbody_Category">
                        </tbody>
                    </table>
                </div>


            </div>

        </div>
    </div>
</div>

<script src="~/Web/js/xlsx.full.min.js"></script>

