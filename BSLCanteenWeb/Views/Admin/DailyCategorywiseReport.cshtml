
@{
    ViewBag.Title = "DailyCategorywiseReport";
}


<script type="text/javascript">

    $(document).ready(function () {

        Fn_DailyReport_Canteenwise();
        Fn_DailyReport_ItemCategorywise();

        const CurrentDate = new Date();
        const yyyy = CurrentDate.getFullYear();
        const monthnames = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
            "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

        let dd = CurrentDate.getDate();
        if (dd < 10) dd = '0' + dd;

        const mmm = monthnames[CurrentDate.getMonth()];

        const dateformat = dd + '-' + mmm + '-' + yyyy;

        $("#spnTodayDate").html(dateformat);

    });


    function Fn_DailyReport_Canteenwise() {
        var clsCategoryReport = {};

        var html = "";
        $("#tbody_Canteen").html("");

        $.ajax({
            type: "POST",
            url: "/Admin/Fn_DailyReport_Canteenwise",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsCategoryReport),
            success: function (data) {
                var obj = JSON.parse(data.message);
                if (obj[0].vErrorMsg == "Success") {
                    for (var i = 0; i < obj.length; i++) {
                        html += "<tr>";
                        html += "<td>" + obj[i].CanteenName + "</td>";
                        html += "<td>" + obj[i].Noofworkers + "</td>";
                        html += "<td>" + obj[i].GeneratedCoupons + "</td>";
                        html += "<td>" + obj[i].ScannedCoupons + "</td>";
                        html += "</tr>";
                    }
                }
                else {
                    html += "<tr><td colspan='12' class='text-center'>Canteen wise records are not found.</td></tr>";
                }
                $("#tbody_Canteen").append(html);
            },
            error: function (err) {
                alert(err);
            }
        });
    }


    function Fn_DailyReport_ItemCategorywise() {

        var clsCategoryReport = {};

        var html = "";
        $("#tbody_Category").html("");

        $.ajax({
            type: "POST",
            url: "/Admin/Fn_DailyReport_ItemCategorywise",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            data: JSON.stringify(clsCategoryReport),
            success: function (data) {
                var obj = JSON.parse(data.message);
                if (obj[0].vErrorMsg == "Success") {
                    for (var i = 0; i < obj.length; i++) {
                        html += "<tr>";
                        html += "<td>" + obj[i].CanteenName + "</td>";
                        html += "<td>" + obj[i].Noofworkers + "</td>";
                        html += "<td style='background-color:#E1BEE7;'>" + obj[i].GeneratedCouponTea + "</td>";
                        html += "<td style='background-color:#E1BEE7;'>" + obj[i].QRScannedTea + "</td>";
                        html += "<td style='background-color:#FFCCBC;'>" + obj[i].GeneratedCouponBreakfast + "</td>";
                        html += "<td style='background-color:#FFCCBC;'>" + obj[i].QRScannedBreakfast + "</td>";
                        html += "<td style='background-color:#ADD8E6;'>" + obj[i].GeneratedCouponThali + "</td>";
                        html += "<td style='background-color:#ADD8E6;'>" + obj[i].QRScannedThali + "</td>";
                        html += "<td style='background-color:#C8E6C9;'>" + obj[i].GeneratedCouponMiniThali + "</td>";
                        html += "<td style='background-color:#C8E6C9;'>" + obj[i].QRScannedMiniThali + "</td>";
                        html += "</tr>";
                    }
                }
                else {
                    html += "<tr><td colspan='12' class='text-center'>Item category wise records are not found.</td></tr>";
                }
                $("#tbody_Category").append(html);
            },
            error: function (err) {
                alert(err);
            }
        });
    }

</script>


<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">
            <h4>Daily Canteen and Item Category Wise Report</h4>
            <p><b>Today's <span id="spnTodayDate"></span> Generated and Scanned Count</b></p>                                     
        
            <div class="card">

                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Canteen Name</th>
                                <th>No of Workers</th>
                                <th>Generated Count</th>
                                <th>Scanned Count</th>
                            </tr>
                        </thead>
                        <tbody id="tbody_Canteen">
                        </tbody>
                    </table>
                </div>



                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Canteen Name</th>
                                <th>Workers</th>
                                <th style="background-color: #E1BEE7;">Tea</th>
                                <th style="background-color: #E1BEE7;">QR Tea</th>
                                <th style="background-color: #FFCCBC;">Breakfast</th>
                                <th style="background-color: #FFCCBC;">QR Breakfast</th>
                                <th style="background-color: #ADD8E6;">Thali</th>
                                <th style="background-color: #ADD8E6;">QRThali</th>
                                <th style="background-color: #C8E6C9;">Mini Thali</th>
                                <th style="background-color: #C8E6C9;">QR Mini Thali</th>
                            </tr>
                        </thead>
                        <tbody id="tbody_Category">
                        </tbody>
                    </table>
                </div>
            </div>
            
        
        </div>      
    </div>
</div>