
@{
    ViewBag.Title = "AdminDashboard";
}

@{

    <script src="~/Web/js/jquery-3.7.1.min.js"></script>
    <link href="~/Web/css/select2.min.css" rel="stylesheet" />
    <script>

        $(document).ready(function () {
           
            Fn_Get_Recent_Coupon_Transactions();
            Fn_Get_Count_ItemMenu();

        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        function Fn_Get_Recent_Coupon_Transactions() {

            var today = new Date();

            var day = String(today.getDate()).padStart(2, '0');
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = months[today.getMonth()];
            var year = today.getFullYear();

            var formattedDate = day + "-" + month + "-" + year;
            $("#spnTodays").html(formattedDate);

            var clsCouponReport = {};
            clsCouponReport.OrderStatus = "Scanned";
            clsCouponReport.OrderTakenDate = formattedDate;
            clsCouponReport.EmpLocation = sessionStorage.getItem("EmpLocation");
            $("#tbodyRecent_TNX").html('');
            var html = '';
            $.ajax({
                type: "POST",
                url: "/Admin/Fn_Get_Coupon_Order",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsCouponReport),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {
                        for (var i = 0; i < obj.length; i++) {
                            html += "<tr>";
                            html += "<td>" + obj[i].OrderTakenTime + "</td>";
                            html += "<td>" + obj[i].CouponId + "</td>";
                            html += "<td>" + obj[i].EmpId + "</td>";
                            html += "<td>" + obj[i].EmpName + (obj[i].CouponType != 'Self' ? " <b>(" + obj[i].CouponType + ")</b>" : "") + "</td>";
                            html += "<td>" + obj[i].EmpDepartment + "</td>";
                            html += "<td>" + obj[i].CategoryIcon + " " + obj[i].ItemCategory + " <b>(₹" + obj[i].Price + ")</b></td>";
                            html += "<td>" + obj[i].CanteenName + "</td>";
                            html += "</tr>";
                        }
                    }
                    else {
                        html += "<tr>";
                        html += "<td colspan='7' class='text-center'>" + obj[0].vErrorMsg + "</td>";
                        html += "<tr>";
                    }
                    $("#tbodyRecent_TNX").append(html);
                },
                error: function (err) {
                    alert(err);

                }
            });
        }

        function Fn_Get_Count_ItemMenu() {

            var today = new Date();

            var day = String(today.getDate()).padStart(2, '0');
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = months[today.getMonth()];
            var year = today.getFullYear();

            var formattedDate = day + "-" + month + "-" + year;

            var clsCountMenuItem = {};
            clsCountMenuItem.OrderTakenDate = formattedDate;
            clsCountMenuItem.CanteenId = sessionStorage.getItem("CanteenId");
            //clsCountMenuItem.EmpLocation = sessionStorage.getItem("EmpLocation");
            $("#ItemCountRow").html('');
            var html = '';
            $.ajax({
                type: "POST",
                url: '/Admin/Fn_Get_Count_ItemMenu',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsCountMenuItem),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    if (obj[0].vErrorMsg == "Success") {

                        var cardStyles = [
                            { bg: "#E3F2FD", border: "#2196F3", shadow: "rgba(33,150,243,0.25)" },
                            { bg: "#E8F5E9", border: "#4CAF50", shadow: "rgba(76,175,80,0.25)" },
                            { bg: "#FFF3E0", border: "#FF9800", shadow: "rgba(255,152,0,0.25)" },
                            { bg: "#F3E5F5", border: "#9C27B0", shadow: "rgba(156,39,176,0.25)" },
                            { bg: "#FCE4EC", border: "#E91E63", shadow: "rgba(233,30,99,0.25)" },
                            { bg: "#E0F7FA", border: "#00BCD4", shadow: "rgba(0,188,212,0.25)" }
                        ];

                        html += "<div class='row food-card-container'>";

                        for (var i = 0; i < obj.length; i++) {

                            var style = cardStyles[i % cardStyles.length];

                            html += "<div class='col-3 mb-3'>";
                            html += "<div class='p-3' style='background:" + style.bg + ";" + "border:1px solid " + style.border + ";" + "border-radius:15px; box-shadow:0 5px 15px " + style.shadow + ";" + "height:100%;'>";
                            html += "<div style='font-size:12px;font-weight:800;color:" + style.border + ";'>";
                            html += obj[i].CategoryIcon + " " + obj[i].ItemCategory + " - " + obj[i].CountItem;
                            html += "</div>";
                            html += "</div>";
                            html += "</div>";
                        }

                        html += "</div>";

                        $("#ItemCountRow").append(html);
                    }
                    else {

                    }

                },
                error: function (err) {
                    alert(err);
                }
            });
        }


    </script>
   

}


<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">
            <h4>Admin</h4>
            <p>Today's  <span id="spnTodays"></span> Transaction</p>
            <div class="row" id="ItemCountRow">
            </div>

            <div class="card">
                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Time</th>
                                <th>Coupon</th>
                                <th>Emp No</th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Item</th>
                                <th>Canteen</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyRecent_TNX"></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Team End -->
