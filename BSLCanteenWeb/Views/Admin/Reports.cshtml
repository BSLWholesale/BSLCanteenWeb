                        <input type="text" id="txtToDate" class="form-control" />
                    </div>
                    <div class="col-sm-4">
                        <label>Canteen</label>
                        <select id="ddlCanteen" class="form-control">
                            <option value="0">--Select--</option>
                        </select>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-6">

                        <div class="row mt-1">
                            <!-- Detail Column -->
                            <div class="col-md-6">
                                <label>
                                    <input type="radio" name="rb" value="Canteenwise" onchange="onRadioChange()" checked="checked" />
