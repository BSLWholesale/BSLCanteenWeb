
@{
    ViewBag.Title = "Reports";
}

@{
    <script src="~/Web/js/jquery-3.7.1.min.js"></script>
    <link href="~/Web/css/select2.min.css" rel="stylesheet" />
    <script src="~/Web/js/jquery-ui.min.js"></script>
    <link href="~/Web/css/jquery-ui.css" rel="stylesheet" />
    <script type="text/javascript">

        $(document).ready(function () {

            var today = new Date();

            var twoMonthsAgo = new Date();
            twoMonthsAgo.setMonth(twoMonthsAgo.getMonth() - 2);

            $("#txtFromDate").datepicker({
                dateFormat: "d-M-yy",
                minDate: twoMonthsAgo,
                maxDate: today,
                defaultDate: today
            });

            $("#txtFromDate").datepicker("setDate", today);

            $("#txtToDate").datepicker({
                dateFormat: "d-M-yy",
                minDate: twoMonthsAgo,
                maxDate: today,
                defaultDate: today
            });

            $("#txtToDate").datepicker("setDate", today);

            Fn_Fill_DropdownList("ddlCanteen", "CanteenMaster", "CanteenName", "", "");


        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }

        var currentPage = 1;
        var pageSize = 1500;
        var isLoading = false;
        var hasMoreData = true;
        var rCount = 0;
        var totalRows = 0;
        var totalCoupons = 0;
        var totalPrice = 0;
        var loadedRows = 0;


        // Canteen-wise running totals
        var previousCanteen = "";


        // Grand totals
        var grandTotalCoupons = 0;
        var grandTotalPrice = 0;

        function formatDate(date) {
            var day = String(date.getDate()).padStart(2, '0');
            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = months[date.getMonth()];
            var year = date.getFullYear();

            return day + "-" + month + "-" + year;
        }
       

        function onRadioChange() {

            var selectedValue = $('input[name="rb"]:checked').val();
            if (selectedValue == "Canteenwise") {
                Fn_CanteenWise_Report();
            }
            else if (selectedValue == "CanteenwiseSummery") {
                Fn_CanteenWise_Summery();
            }
            else {

            }
        }



        function Fn_ExportExcel() {

            var tab = "";
            var strFileName = "";
            var dt = new Date();
            dt = dt.toLocaleDateString();
            var selectedValue = $('input[name="rb"]:checked').val();

            if (selectedValue == "Canteenwise") {
                tab = document.getElementById('tblCanteen');
                strFileName = "Canteenwise-Detail-" + dt;
            }
            else if (selectedValue == "CanteenwiseSummery") {
                tab = document.getElementById('tblSummery');
                strFileName = "Canteenwise-Summery-" + dt;
            }
            else
            {
               
            }

            var tab_text = "<table border='2px'>";

            for (var j = 0; j < tab.rows.length; j++) {

                tab_text += "<tr>";

                var cells = tab.rows[j].cells;

                for (var i = 0; i < cells.length; i++) {

                    var cellValue = "";
                    var tagName = cells[i].tagName.toLowerCase();

                    // Check if td has class="clsmenu"
                    if (cells[i].classList.contains("clsmenu")) {

                        // Export only plain text
                        cellValue = cells[i].textContent
                            .replace(/☕/g, "")
                            .replace(/🍛/g, "")
                            .replace(/🍽️/g, "")
                            .replace(/\s+/g, " ")
                            .trim();

                    } else {

                        // Normal text
                        cellValue = cells[i].innerText.trim();
                    }

                    if (tagName === "th") {

                        tab_text += "<th bgcolor='#87AFC6'>" + cellValue + "</th>";

                    }
                    else if (i === 0) {

                        tab_text += "<td style=\"mso-number-format:'0';\">" + cellValue + "</td>";

                    }
                    else {

                        tab_text += "<td>" + cellValue + "</td>";
                    }
                }

                tab_text += "</tr>";
            }

            tab_text += "</table>";

            // Remove unwanted HTML elements
            tab_text = tab_text.replace(/<A[^>]*>|<\/A>/gi, "");
            tab_text = tab_text.replace(/<img[^>]*>/gi, "");
            tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

            var ua = window.navigator.userAgent;
            var msie = ua.indexOf("MSIE ");

            var sa = "";

            if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {

                txtArea1.document.open("txt/html", "replace");
                txtArea1.document.write(tab_text);
                txtArea1.document.close();
                txtArea1.focus();

                sa = txtArea1.document.execCommand(
                    "SaveAs",
                    true,
                    strFileName + ".xls"
                );

            } else {

                var blob = new Blob(
                    [tab_text],
                    {
                        type: "application/vnd.ms-excel"
                    }
                );

                var link = document.createElement("a");

                link.href = URL.createObjectURL(blob);
                link.download = strFileName + ".xls";

                document.body.appendChild(link);
                link.click();

                document.body.removeChild(link);
            }

            return sa;
        }
        

        function Fn_CanteenWise_Summery(isScroll = false) {

            if (isLoading || (isScroll && !hasMoreData)) {
                return;
            }

            if (!isScroll) {
                currentPage = 1;
                hasMoreData = true;
                totalRows = 0;
                loadedRows = 0;
                totalCoupons = 0;
                totalPrice = 0;

                $("#tbodySummery").html('');
                $("#spnToalRowCount").html('');

                // Date-wise total variables
                previousDate = "";
                dateCoupons = 0;
                datePrice = 0;
            }

            isLoading = true;

            var clsMonthlyReportReq = {};

            clsMonthlyReportReq.OrderStatus = "Scanned";
            clsMonthlyReportReq.EmpLocation = sessionStorage.getItem("EmpLocation");
            clsMonthlyReportReq.PageNumber = currentPage;
            clsMonthlyReportReq.PageSize = pageSize;
            clsMonthlyReportReq.QueryType = "CanteenWise_Summery";

            if ($("#ddlCanteen").val() != "0") {
                clsMonthlyReportReq.CanteenName = $("#ddlCanteen").val();
            }

            if ($("#txtFromDate").val() != "") {
                clsMonthlyReportReq.FromDate = $("#txtFromDate").val();
            }

            if ($("#txtToDate").val() != "") {
                clsMonthlyReportReq.ToDate = $("#txtToDate").val();
            }

            $.ajax({
                type: "POST",
                url: "/Admin/Fn_CanteenWise_Summery",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsMonthlyReportReq),

                success: function (data) {

                    var obj = JSON.parse(data.message);
                    var html = "";

                    if (obj.length > 0 && obj[0].vErrorMsg == "Success") {

                        totalRows = parseInt(obj[0].TotalRows) || 0;

                        for (var i = 0; i < obj.length; i++) {

                            var currentDate = obj[i].OrderTakenDate;
                            var coupons = parseInt(obj[i].TotalCoupons) || 0;
                            var price = parseFloat(obj[i].TotalPrice) || 0;

                            if (previousDate !== "" && previousDate !== currentDate) {

                                html += "<tr class='date-total-row' style='font-weight:bold;background:#e8f0fe;'>";
                                html += "<th></th>";
                                html += "<th style='text-align:right;'>Total (" + previousDate + ")</th>";
                                html += "<th style='text-align:right;'>" + dateCoupons + "</th>";
                                html += "<th style='text-align:right;'>" + datePrice.toFixed(2) + "</th>";
                                html += "</tr>";

                                dateCoupons = 0;
                                datePrice = 0;
                            }

                            html += "<tr>";
                            html += "<td>" + obj[i].CanteenName + "</td>";
                            html += "<td>" + currentDate + "</td>";
                            html += "<td style='text-align:right;'>" + coupons + "</td>";
                            html += "<td style='text-align:right;'>" + price.toFixed(2) + "</td>";
                            html += "</tr>";

                            dateCoupons += coupons;
                            datePrice += price;

                            totalCoupons += coupons;
                            totalPrice += price;

                            previousDate = currentDate;
                            loadedRows++;
                        }

                        $("#tbodySummery").append(html);
                        $("#tbodySummery .total-row").remove();

                        var allRecordsLoaded = (loadedRows >= totalRows || obj.length < pageSize);

                        if (allRecordsLoaded && previousDate !== "") {

                            var lastDateHtml = "";

                            lastDateHtml += "<tr class='date-total-row' style='font-weight:bold;background:#e8f0fe;'>";
                            lastDateHtml += "<th></th>";
                            lastDateHtml += "<th style='text-align:right;'>Total (" + previousDate + ")</th>";
                            lastDateHtml += "<th style='text-align:right;'>" + dateCoupons + "</th>";
                            lastDateHtml += "<th style='text-align:right;'>" + datePrice.toFixed(2) + "</th>";
                            lastDateHtml += "</tr>";

                            $("#tbodySummery").append(lastDateHtml);
                        }

                        // Grand total
                        var totalHtml = "";

                        totalHtml += "<tr class='total-row' style='font-weight:bold;background:#d9ead3;'>";
                        totalHtml += "<th></th>";
                        totalHtml += "<th style='text-align:right;'>Grand Total</th>";
                        totalHtml += "<th style='text-align:right;'>" + totalCoupons + "</th>";
                        totalHtml += "<th style='text-align:right;'>" + totalPrice.toFixed(2) + "</th>";
                        totalHtml += "</tr>";

                        $("#tbodySummery").append(totalHtml);

                        $("#spnToalRowCount").html("Total Records: " + loadedRows + " / " + totalRows);

                        $("#tblCanteen").hide();
                        $("#tblSummery").show();

                        if (allRecordsLoaded) {
                            hasMoreData = false;
                        }
                        else {
                            hasMoreData = true;
                            currentPage++;
                        }

                    }
                    else {

                        if (!isScroll) {
                            html = "<tr><td colspan='4' class='text-center'>" +
                                (obj.length > 0 ? obj[0].vErrorMsg : "No records found") +
                                "</td></tr>";

                            $("#tbodySummery").html(html);
                        }

                        hasMoreData = false;
                        $("#tblCanteen").hide();
                        $("#tblSummery").show();
                    }
                },
                error: function (err) {
                    console.log(err);
                },
                complete: function () {
                    isLoading = false;
                }
            });
        }

        

        var canteenReportIsLoading = false;
        var canteenReportHasMoreData = true;

        var canteenReportTotalRows = 0;
        var canteenReportLoadedRows = 0;

        function Fn_CanteenWise_Report(isScroll = false) {


            if (canteenReportIsLoading ||
                (isScroll && !canteenReportHasMoreData)) {
                return;
            }

            if (!isScroll) {

                currentPage = 1;
                canteenReportHasMoreData = true;

                canteenReportTotalRows = 0;
                canteenReportLoadedRows = 0;

                previousCanteen = "";
                totalCoupons = 0;
                totalPrice = 0;

                grandTotalCoupons = 0;
                grandTotalPrice = 0;

                $("#tbodyCanteen").html('');
                $("#spnToalRowCount").html('');
            }

            canteenReportIsLoading = true;

            var clsMonthlyReportReq = {};

            clsMonthlyReportReq.OrderStatus = "Scanned";
            clsMonthlyReportReq.EmpLocation = sessionStorage.getItem("EmpLocation");
            clsMonthlyReportReq.PageNumber = currentPage;
            clsMonthlyReportReq.PageSize = pageSize;
            clsMonthlyReportReq.QueryType = "CanteenWise_Detail";

            if ($("#ddlCanteen").val() != "0") {
                clsMonthlyReportReq.CanteenName = $("#ddlCanteen").val();
            }

            if ($("#txtFromDate").val() != "") {
                clsMonthlyReportReq.FromDate = $("#txtFromDate").val();
            }

            if ($("#txtToDate").val() != "") {
                clsMonthlyReportReq.ToDate = $("#txtToDate").val();
            }

            $.ajax({

                type: "POST",
                url: "/Admin/Fn_CanteenWise_Report",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsMonthlyReportReq),

                success: function (data) {

                    var obj = JSON.parse(data.message);
                    var html = "";

                    if (obj.length > 0 && obj[0].vErrorMsg == "Success") {

                        canteenReportTotalRows = parseInt(obj[0].TotalRows) || 0;

                        $("#tbodyCanteen .grand-total-row").remove();

                        if (!isScroll) {

                            html += "<tr style='font-weight:bold;background-color:#e9ecef;'>";
                            html += "<th style='text-align:center;'>Report</th>";
                            html += "<th style='text-align:center;'>From</th>";
                            html += "<th style='text-align:center;'>" + (clsMonthlyReportReq.ToDate || "") + "</th>";
                            html += "<th style='text-align:center;'>To</th>";
                            html += "<th style='text-align:center;'>" + (clsMonthlyReportReq.FromDate || "") + "</th>";
                            html += "</tr>";
                        }

                        for (var i = 0; i < obj.length; i++) {

                            var currentCanteen = obj[i].CanteenName;
                            var coupons = parseInt(obj[i].TotalCoupons) || 0;
                            var price = parseFloat(obj[i].TotalPrice) || 0;

                            if (previousCanteen != "" && previousCanteen != currentCanteen) {

                                html += "<tr class='canteen-total-row' ";
                                html += "style='font-weight:bold;background:#f2f2f2;'>";
                                html += "<th align='left'>Total (" + previousCanteen + ")</th>";
                                html += "<th></th>";
                                html += "<th></th>";
                                html += "<th style='text-align:right;'>" + totalCoupons + "</th>";
                                html += "<th style='text-align:right;'>" + totalPrice.toFixed(2) + "</th>";
                                html += "</tr>";

                                totalCoupons = 0;
                                totalPrice = 0;
                            }

                            previousCanteen = currentCanteen;

                            // Canteen totals
                            totalCoupons += coupons;
                            totalPrice += price;

                            // Grand totals
                            grandTotalCoupons += coupons;
                            grandTotalPrice += price;

                            // Detail row
                            html += "<tr>";
                            html += "<td>" + obj[i].CanteenName + "</td>";
                            html += "<td>" + obj[i].OrderTakenDate + "</td>";
                            html += "<td class='clsmenu'>" + obj[i].CategoryIcon + " " + obj[i].ItemCategory + "</td>";
                            html += "<td style='text-align:right;'>" + coupons + "</td>";
                            html += "<td style='text-align:right;'>" + price.toFixed(2) + "</td>";
                            html += "</tr>";

                            canteenReportLoadedRows++;
                        }

                        $("#tbodyCanteen").append(html);

                        if (canteenReportLoadedRows >= canteenReportTotalRows || obj.length < pageSize) {

                            canteenReportHasMoreData = false;

                            // Last canteen subtotal
                            if (previousCanteen != "") {

                                var lastTotal = "";

                                lastTotal += "<tr class='canteen-total-row' ";
                                lastTotal += "style='font-weight:bold;background:#f2f2f2;'>";
                                lastTotal += "<th align='left'>Total (" + previousCanteen + ")</th>";
                                lastTotal += "<th></th>";
                                lastTotal += "<th></th>";
                                lastTotal += "<th style='text-align:right;'>" + totalCoupons + "</th>";
                                lastTotal += "<th style='text-align:right;'>" + totalPrice.toFixed(2) + "</th>";
                                lastTotal += "</tr>";
                                $("#tbodyCanteen").append(lastTotal);
                            }

                            // Grand total
                            var grandHtml = "";

                            grandHtml += "<tr class='grand-total-row' ";
                            grandHtml += "style='font-weight:bold;background:#d9edf7;color:#000;'>";
                            grandHtml += "<th align='left'>Grand Total</th>";
                            grandHtml += "<th></th>";
                            grandHtml += "<th></th>";
                            grandHtml += "<th style='text-align:right;'>" + grandTotalCoupons + "</th>";
                            grandHtml += "<th style='text-align:right;'>" + grandTotalPrice.toFixed(2) + "</th>";
                            grandHtml += "</tr>";
                            $("#tbodyCanteen").append(grandHtml);

                        }
                        else {

                            canteenReportHasMoreData = true;
                            currentPage++;
                        }

                        $("#spnToalRowCount").html("Total Records: " + canteenReportLoadedRows + " / " + canteenReportTotalRows);

                        $("#tbodySummery").html('');
                        $("#tblSummery").hide();
                        
                        $("#tblCanteen").show();

                    }
                    else {

                        if (!isScroll) {

                            html += "<tr>";
                            html += "<td colspan='5' class='text-center'>";
                            html += (obj.length > 0 ?
                                obj[0].vErrorMsg : "No records found");
                            html += "</td>";
                            html += "</tr>";

                            $("#tbodyCanteen").html(html);
                        }

                        canteenReportHasMoreData = false;

                        $("#tblCanteen").show();
                    }
                },
                error: function (err) {
                    console.log(err);
                },
                complete: function () {
                    canteenReportIsLoading = false;
                }
            });
        }


        $(window).scroll(function () {

            if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {

                var selectedValue = $('input[name="rb"]:checked').val();
                if (selectedValue == "Canteenwise") {
                    Fn_CanteenWise_Report(true);
                } 
                else if (selectedValue == "CanteenwiseSummery") {
                    Fn_CanteenWise_Summery(true)
                }
                else {

                }
            }

        });

        function Fn_Go_EmployeeReport() {
            window.location.href = "/Report/EmployeeReport";
        }

    </script>

}


<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">
