                <h4>Report Datewise</h4>
                <span style="font-weight: 700;" id="spnToalRowCount">Total Rows: 0</span>
            </div>
            <div class="card">
                <div class="row mt-2">
                    <div class="col-sm-4">
                        <label>From Date</label>
                        <input type="text" id="txtFromDate" class="form-control" />
                    </div>
                    <div class="col-sm-4">
