                                </label>
                            </div>

                            <!-- Summary Column -->
                            <div class="col-md-6">
                                <label>
                                    <input type="radio" name="rb" value="CanteenwiseSummery" onchange="onRadioChange()" />
                                    Canteenwise Summary
                                </label>
                            </div>
                        </div>

                    </div>
                    <div class="col-sm-6 position-relative">
                        <div class="position-absolute end-0" style="padding-right: 15px;">
                            <button id="btnSearch" class="btn btn-primary" onclick="onRadioChange();"> Search</button>
                            <button id="btnExport" class="btn btn-primary" onclick="Fn_ExportExcel();"> Export</button>
                            <button id="btnExport" class="btn btn-primary" onclick="Fn_Go_EmployeeReport();">View Employee Report</button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive mt-3">
                    <table class="table table-bordered table-hover" id="tblCanteen" style="display: none;">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                @*<th>Canteen Id</th>*@
                                <th>Canteen Name</th>
                                <th>Order Date</th>
                                <th>Item</th>
                                <th style="text-align:right">TotalCoupons</th>
                                <th style="text-align:right">Amt</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyCanteen"></tbody>
                    </table>

                    <!-- Canteen Summery Start-->

                    <table class="table table-bordered table-hover" id="tblSummery" style="display: none;">
                        <thead>
                            <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                <th>Canteen Name</th>
                                <th>Order Date</th>
                                <th style="text-align:right">TotalCoupons</th>
                                <th style="text-align:right">Amt</th>
                            </tr>
                        </thead>
                        <tbody id="tbodySummery"></tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- Team End -->
