
@{
    ViewBag.Title = "CouponStatusReport";
}

@{
    <script src="~/Web/js/jquery-3.7.1.min.js"></script>
    <link href="~/Web/css/select2.min.css" rel="stylesheet" />
    <script src="~/Web/js/jquery-ui.min.js"></script>
    <link href="~/Web/css/jquery-ui.css" rel="stylesheet" />
    <script type="text/javascript">

        $(document).ready(function () {

            var today = new Date();

            var twoMonthsAgo = new Date();
            twoMonthsAgo.setMonth(twoMonthsAgo.getMonth() - 2);

            $("#txtFromDate").datepicker({
                dateFormat: "d-M-yy",
                minDate: twoMonthsAgo,
                maxDate: today,
                defaultDate: today
            });

            $("#txtFromDate").datepicker("setDate", today);

            $("#txtToDate").datepicker({
                dateFormat: "d-M-yy",
                minDate: twoMonthsAgo,
                maxDate: today,
                defaultDate: today
            });

            $("#txtToDate").datepicker("setDate", today);

            Fn_Fill_DropdownList("ddlCanteen", "CanteenMaster", "CanteenName", "CanteenId", "");

        });

        function Fn_Fill_DropdownList(ddlName, strTBLName, strFieldName, strValueField, strCriteria) {
            var clsRequestDropdown = {};
            clsRequestDropdown.vFieldName = strFieldName;
            clsRequestDropdown.vValueField = strValueField;
            clsRequestDropdown.vTBLName = strTBLName;
            clsRequestDropdown.vCriteria = strCriteria;
            $("#" + ddlName).html('');
            var dropdown = ''; var dropdown1 = "";
            dropdown1 = "<option value='0'>--Select--</option>";
            $("#" + ddlName).append(dropdown1);
            $.ajax({
                type: "POST",
                url: '/Home/Fn_Fill_DropdownList',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsRequestDropdown),
                success: function (data) {
                    var obj = JSON.parse(data.message);
                    for (var i = 0; i < obj.length; i++) {
                        if (strValueField == "") {
                            dropdown += "<option value='" + obj[i].vFieldName + "'>" + obj[i].vFieldName + "</option>";
                        }
                        else {
                            dropdown += "<option value='" + obj[i].vValueField + "'>" + obj[i].vFieldName + "</option>";
                        }

                    }
                    $("#" + ddlName).append(dropdown);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }


        var currentPage = 1;
        var pageSize = 1000;
        var isLoading = false;
        var hasMoreData = true;
        var totalRows = 0;

        function Fn_Get_Coupon_Status_Report(isScroll) {

            isScroll = isScroll || false;

            // Prevent duplicate AJAX calls
            if (isLoading || (isScroll && !hasMoreData)) {
                return;
            }

            // Reset data for a new search
            if (!isScroll) {
                currentPage = 1;
                hasMoreData = true;
                totalRows = 0;

                $("#tbodyCanteen").empty();
                $("#spnToalRowCount").html("Total Records: 0");
            }

            isLoading = true;

            var clsOrderStatusReq = {};

            clsOrderStatusReq.EmpLocation = sessionStorage.getItem("EmpLocation");
            clsOrderStatusReq.PageNumber = currentPage;
            clsOrderStatusReq.PageSize = pageSize;

            var selectedValue = $('input[name="rbCheck"]:checked').val();

            if ($("#ddlCanteen").val() != "0") {
                clsOrderStatusReq.CanteenId = $("#ddlCanteen").val();
            }

            if ($("#ddlOrderStatus").val() != "0") {
                clsOrderStatusReq.OrderStatus = $("#ddlOrderStatus").val();
            }

            if (selectedValue == "CoupIssueDate") {

                if ($("#txtFromDate").val() != "") {
                    clsOrderStatusReq.CoupIssueStartDate = $("#txtFromDate").val();
                }

                if ($("#txtToDate").val() != "") {
                    clsOrderStatusReq.CoupIssueEndDate = $("#txtToDate").val();
                }

            }
            else if (selectedValue == "OrderTakenDate") {

                if ($("#txtFromDate").val() != "") {
                    clsOrderStatusReq.OrderStartDate = $("#txtFromDate").val();
                }

                if ($("#txtToDate").val() != "") {
                    clsOrderStatusReq.OrderEndDate = $("#txtToDate").val();
                }
            }

            $.ajax({
                type: "POST",
                url: "/Report/Fn_Get_Coupon_Status_Report",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(clsOrderStatusReq),
                success: function (data) {
                    var obj = [];

                    obj = typeof data.message === "string" ? JSON.parse(data.message) : data.message;
                    if (obj[0].vErrorMsg == "Success") {

                        totalRows = parseInt(obj[0].TotalRows, 10) || 0;

                        var html = "";
                        var recordsLoaded = 0;

                        for (var i = 0; i < obj.length; i++) {
                          
                            if (obj[i].CouponId == null) {
                                continue;
                            }

                            html += "<tr>";
                            html += "<td>" + (obj[i].CouponId ?? "") + "</td>";
                            html += "<td>" + (obj[i].CoupIssueDate ?? "") + "</td>";
                            html += "<td>" + (obj[i].OrderTakenDate ?? "") + "</td>";
                            html += "<td>" + (obj[i].CanteenName ?? "") + "</td>";
                            html += "<td>" + (obj[i].EmpId ?? "") + "</td>";
                            html += "<td>" + (obj[i].EmpName ?? "") + "</td>";
                            html += "<td>" + (obj[i].EmpLocation ?? "") + "</td>";
                            html += "<td>" + (obj[i].ItemName ?? "") + "</td>";
                            html += "<td>" + (obj[i].Price ?? "") + "</td>";
                            html += "</tr>";

                            recordsLoaded++;
                        }

                        $("#tbodyCanteen").append(html);

                        var loadedRows = $("#tbodyCanteen tr").filter(function () {
                            return $(this).children("td").length === 9;
                        }).length;

                        $("#spnToalRowCount").html("Total Records: " + loadedRows + " / " + totalRows);
                        if (recordsLoaded === 0) {
                            hasMoreData = false;
                            return;
                        }
                       
                        currentPage++;                     
                        hasMoreData = loadedRows < totalRows;

                    }
                    else {

                        hasMoreData = false;

                        if (!isScroll) {
                            $("#tbodyCanteen").html("<tr><td colspan='9' class='text-center'>" + (obj[0].vErrorMsg || "No records found.") + "</td></tr>");
                            $("#spnToalRowCount").html("Total Records: 0");
                        }
                    }
                },
                error: function (err) {
                    alert("Error loading coupon status report:", err);
                },
                complete: function () {
                    isLoading = false;
                }
            });
        }


        $(window).off("scroll.couponStatusReport").on("scroll.couponStatusReport", function () {

            if (
                $(window).scrollTop() + $(window).height()
                >= $(document).height() - 100
            ) {
                Fn_Get_Coupon_Status_Report(true);
            }
        });

        function Fn_ExportExcel() {

            var sa = "";
            var tab = "";
            var today = new Date();
            var strFileName = "CouponStatutReport" + today.toLocaleString();
            var tab = document.getElementById('tblCanteen');

            var tab_text = "<table border='2px'>";

            for (var j = 0; j < tab.rows.length; j++) {

                tab_text += "<tr>";
                var cells = tab.rows[j].cells;
                for (var i = 0; i < cells.length; i++) {

                    var cellValue = "";
                    var tagName = cells[i].tagName.toLowerCase();

                    // Check if td has class="clsmenu"
                    if (cells[i].classList.contains("clsmenu")) {

                        // Export only plain text
                        cellValue = cells[i].textContent
                            .replace(/☕/g, "")
                            .replace(/🍛/g, "")
                            .replace(/🍽️/g, "")
                            .replace(/₹/g, "")
                            .replace(/\s+/g, " ")
                            .trim();

                    } else {

                        // Normal text
                        cellValue = cells[i].innerText.trim();
                    }

                    if (tagName === "th") {

                        tab_text += "<th bgcolor='#87AFC6'>" + cellValue + "</th>";

                    }
                    else if (i === 0) {

                        tab_text += "<td style=\"mso-number-format:'0';\">" + cellValue + "</td>";

                    }
                    else {

                        tab_text += "<td>" + cellValue + "</td>";
                    }
                }

                tab_text += "</tr>";
            }

            tab_text += "</table>";

            // Remove unwanted HTML elements
            tab_text = tab_text.replace(/<A[^>]*>|<\/A>/gi, "");
            tab_text = tab_text.replace(/<img[^>]*>/gi, "");
            tab_text = tab_text.replace(/<input[^>]*>|<\/input>/gi, "");

            var ua = window.navigator.userAgent;
            var msie = ua.indexOf("MSIE ");

            var sa = "";

            if (msie > 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./)) {

                txtArea1.document.open("txt/html", "replace");
                txtArea1.document.write(tab_text);
                txtArea1.document.close();
                txtArea1.focus();

                sa = txtArea1.document.execCommand(
                    "SaveAs",
                    true,
                    strFileName + ".xls"
                );

            } else {

                var blob = new Blob(
                    [tab_text],
                    {
                        type: "application/vnd.ms-excel"
                    }
                );

                var link = document.createElement("a");

                link.href = URL.createObjectURL(blob);
                link.download = strFileName + ".xls";

                document.body.appendChild(link);
                link.click();

                document.body.removeChild(link);
            }

            return sa;
        }

    </script>

}


<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-md-12 col-sm-12">
            <div class="d-flex justify-content-between align-items-center">
                <h4>Report</h4>
                <span style="font-weight: 700;" id="spnToalRowCount">Total Rows: 0</span>
            </div>
            <div class="card">
                <div class="row mt-2">
                    <div class="col-sm-3">
                        <label>From Date</label>
                        <input type="text" id="txtFromDate" class="form-control" />
                    </div>
                    <div class="col-sm-3">
                        <label>To Date</label>
                        <input type="text" id="txtToDate" class="form-control" />
                    </div>
                    <div class="col-sm-3">
                        <label>Canteen</label>
                        <select id="ddlCanteen" class="form-control">
                            <option value="0">--Select--</option>
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label>Order Status</label>
                        <select id="ddlOrderStatus" class="form-control">
                            <option value="0">--Select--</option>
                            <option value="Generated">Generated</option>
                            <option value="Scanned">Scanned</option>
                        </select>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-sm-6">
                        <div class="form-inline">
                            <input type="radio" name="rbCheck" value="CoupIssueDate" checked="checked" /> Coupon Issue Date
                            <input type="radio" name="rbCheck" value="OrderTakenDate" /> Order Date

                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="button" class="btn btn-success" style="float: right;" id="btnExport" value="Export Excel" onclick="Fn_ExportExcel();" />
                            <input type="button" class=" btn btn-primary" style="float: right; margin-right: 2px;" onclick="Fn_Get_Coupon_Status_Report();" id="btnSearch" value="Search" />
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="tblCanteen">
                            <thead>
                                <tr style="background-color: #06BBCC; background-image: linear-gradient(to bottom, #10D4E6, #1BCEDE); color: white;">
                                    <th>CouponId</th>
                                    <th>CoupIssueDate</th>
                                    <th>OrderTakenDate</th>
                                    <th>CanteenName</th>
                                    <th>EmpId</th>
                                    <th>EmpName</th>
                                    <th>EmpLocation</th>
                                    <th>ItemName</th>
                                    <th>Price</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyCanteen"></tbody>
                        </table>
                    </div>
                </div>


            </div>
        </div>
    </div>
</div>
<!-- Team End -->
<script src="~/Web/js/select2.min.js"></script>
<script>
    $(function () {

        $("#ddlCanteen").select2();
        $("#ddlOrderStatus").select2();
    });

</script>

